# Discord bot token (required)
API_KEY=

# Discord channel ID where the status/leaderboard embeds are posted (required)
CHANNEL_ID=

# JSON array of Source-engine servers to monitor, e.g.
# SERVERS=[{"ip":"1.2.3.4","port":2303},{"ip":"1.2.3.4","port":2313}]
SERVERS=[]

# Optional: LAN IP to use instead of a DDNS hostname from the community's
# server preset list, for routing when the bot runs on the same network.
LOCAL_IP=

# Sentry.io DSN for error reporting. All logging is console + Sentry only -
# there is no local log file.
SENTRY_DSN=
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Optional tuning ---
# REFRESH_INTERVAL=10
# QUERY_TIMEOUT=5

# Database file path
DATABASE_FILE=database/data.db

# Maximum retry attempts for server queries
MAX_RETRIES=1

# Custom title for server status embed
CUSTOM_TITLE="Server Status"

# Custom text for server status embed
CUSTOM_TEXT="**DM an admin to join our servers!**"

# Title for leaderboard embed
LEADERBOARD_TITLE=🏆 Player Leaderboard

# Number of players to show in leaderboard
LEADERBOARD_SIZE=5

# Day of month for leaderboard reset (1-31)
MONTHLY_RESET_DAY=1

# Color for status embed (hex)
STATUS_COLOR=0x1A529A

# Color for leaderboard embed (hex)
LEADERBOARD_COLOR=0xFFD700

# URL for footer icon
FOOTER_ICON=https://example.com/icon.jpg

# Interval for kill updates in seconds
KILL_UPDATE_INTERVAL=15

# MISSION_SYNC_DELAY=300

# Optional VPN: see wireguard.txt.example and docker-compose.vpn.yml. Docker
# only - no env var needed here, just `docker compose -f docker-compose.yml
# -f docker-compose.vpn.yml up`.
