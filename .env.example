# === Authentication ===
API_KEY=your_discord_bot_token_here  # REQUIRED: Bot token from Discord Developer Portal

# === Channel Configuration ===
CHANNEL_ID=123456789012345678  # REQUIRED: Channel ID where bot will post updates

# === Server List ===
SERVERS=[{"ip": "127.0.0.1", "port": 27015}]  # REQUIRED: List of game servers to monitor

# === Query Settings ===
QUERY_TIMEOUT=5  # Seconds before server query times out (default: 5)
MAX_RETRIES=3    # Number of retry attempts for failed queries (default: 3)

# === Database Configuration ===
DATABASE_FILE=data.json  # File path for JSON database (default: data.json)

# === Leaderboard Settings ===
LEADERBOARD_SIZE=10       # Number of players shown in leaderboards (default: 10)
MONTHLY_RESET_DAY=1      # Day of month to reset monthly leaderboard (default: 1)
KILL_UPDATE_INTERVAL=300  # Seconds between kill count updates (default: 300)

# === UI Customization ===
CUSTOM_TITLE=🟢 Server Status  # Custom embed title (default: 🟢 Server Status)
CUSTOM_TEXT=**DM an admin to join our servers!**  # Custom message under title
LEADERBOARD_TITLE=🏆 Player Leaderboard  # Leaderboard embed title
STATUS_COLOR=0x1A529A    # Hex color for status embed (default: #1A529A)
LEADERBOARD_COLOR=0xFFD700  # Hex color for leaderboard (default: #FFD700)
FOOTER_ICON=https://example.com/icon.jpg  # URL for embed footer icon

# === Logging Configuration ===
LOG_LEVEL=low    # Options: low (minimal), full (verbose)
LOG_RETENTION=10  # Number of log files to keep (default: 10)
LOG_DIR=logs     # Directory to store logs (default: logs)